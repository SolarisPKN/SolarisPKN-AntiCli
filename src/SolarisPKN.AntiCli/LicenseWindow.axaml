<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SolarisPKN.AntiCli.LicenseWindow"
        Title="GNU GPLv3 · Solaris AntiCLI"
        Width="830" Height="700" MinWidth="500" MinHeight="440"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto" Margin="16" RowSpacing="10">
    <StackPanel Grid.Row="0" Spacing="3">
      <TextBlock Text="GNU General Public License · Version 3" FontSize="20" FontWeight="Bold"/>
      <TextBlock Text="© 2026 SolarisPKN contributors · Source available under GPL-3.0-only. No warranty."
                 TextWrapping="Wrap" Opacity="0.7"/>
    </StackPanel>
    <TextBox x:Name="LicenseText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
             TextWrapping="NoWrap" FontFamily="Consolas,Monospace"/>
    <Button Grid.Row="2" HorizontalAlignment="Right" Content="Cerrar" Click="CloseClicked"/>
  </Grid>
</Window>
