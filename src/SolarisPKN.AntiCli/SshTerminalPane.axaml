<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SolarisPKN.AntiCli.SshTerminalPane">
  <Border BorderBrush="#656D7E" BorderThickness="1" CornerRadius="8" Padding="8"
          MinHeight="0" MinWidth="0">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="7" MinHeight="0">
      <WrapPanel Grid.Row="0" Orientation="Horizontal" ItemSpacing="6" LineSpacing="5">
        <TextBlock Text="Consola SSH" FontWeight="SemiBold" FontSize="15"
                   VerticalAlignment="Center" Margin="0,0,8,0"/>
        <Button x:Name="ExpandConsoleButton" Content="Ampliar" Padding="8,4"/>
        <Button x:Name="DetachConsoleButton" Content="Desacoplar ↗" Padding="8,4"/>
        <Button x:Name="DockPositionButton" Content="Mover a izquierda" Padding="8,4"/>
        <Button x:Name="HideConsoleButton" Content="Ocultar" Padding="8,4"/>
      </WrapPanel>
      <WrapPanel Grid.Row="1" Orientation="Horizontal" ItemSpacing="6" LineSpacing="5">
        <Button x:Name="CopyLogButton" Content="Copiar registro" Padding="8,4"/>
        <Button x:Name="ExportLogButton" Content="Exportar…" Padding="8,4"/>
        <Button x:Name="ClearHistoryButton" Content="Limpiar" Padding="8,4"/>
      </WrapPanel>
      <!-- One continuous chronological log instead of last-output plus separate history.
           The textbox owns vertical and horizontal scrolling within its grid cell. -->
      <TextBox x:Name="CommandHistoryLog" Grid.Row="2" MinHeight="0" MinWidth="0"
               AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas,Monospace"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ScrollViewer.VerticalScrollBarVisibility="Visible"
               Watermark="Los comandos ejecutados aparecerán acá, con su salida y código de salida."/>
      <!-- Compatibility-only state, never visible as a second output/history panel. -->
      <TextBox x:Name="Output" IsVisible="False"/>
      <ListBox x:Name="CommandHistoryList" IsVisible="False"/>
      <Button x:Name="CopyHistoryCommandButton" IsVisible="False"/>
      <Button x:Name="ReuseHistoryCommandButton" IsVisible="False"/>
    </Grid>
  </Border>
</UserControl>
