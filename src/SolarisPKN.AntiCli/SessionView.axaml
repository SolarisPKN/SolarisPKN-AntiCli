<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SolarisPKN.AntiCli"
             x:Class="SolarisPKN.AntiCli.SessionView">
  <Grid RowDefinitions="Auto,*" RowSpacing="12" Margin="18">
    <StackPanel Grid.Row="0" Spacing="3">
      <TextBlock FontSize="26" FontWeight="Bold" Text="Solaris AntiCLI System"/>
      <TextBlock Text="Entorno y credenciales exclusivos de esta pestaña. Los comandos y el historial no se mezclan con otras sesiones." Opacity="0.75"/>
    </StackPanel>
    <TabControl x:Name="MainTabs" Grid.Row="1">
      <TabItem x:Name="ConnectionTab" Header="1 · Entorno y SSH">
        <ScrollViewer>
          <StackPanel Spacing="11" Margin="15">
            <TextBlock FontSize="19" FontWeight="SemiBold" Text="Entorno de trabajo"/>
            <TextBlock Text="Seleccioná primero el sistema operativo del servidor remoto."/>
            <ComboBox x:Name="PlatformSelector" Width="320" HorizontalAlignment="Left"
                      SelectionChanged="PlatformChanged" PlaceholderText="Seleccionar entorno"/>
            <TextBlock Text="Conexión SSH" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock Text="Los datos se recuerdan únicamente cuando marcás su casilla DPAPI. Si no, se usan solo durante esta sesión."
                       TextWrapping="Wrap" Opacity="0.7"/>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Text="Perfiles"/>
                <ListBox x:Name="ProfilesList" Height="100" SelectionChanged="ProfileSelected"/>
                <Button Content="Crear perfil nuevo" Click="NewProfileClicked" HorizontalAlignment="Left"/>
                <TextBlock Text="Nombre del perfil"/>
                <TextBox x:Name="ProfileName" Watermark="Servidor desarrollo"/>
                <TextBlock Text="Host / IP"/>
                <TextBox x:Name="HostInput" Watermark="192.168.1.50"/>
                <TextBlock Text="Puerto SSH"/>
                <TextBox x:Name="PortInput" Text="22"/>
                <TextBlock Text="Huella pública del servidor SSH (SHA256:)"/>
                <TextBox x:Name="FingerprintInput" Watermark="Se completa al confirmar la clave del VPS"/>
                <Button Content="🛡 Detectar / revisar clave del servidor" Click="DiscoverHostKeyClicked"
                        HorizontalAlignment="Left"/>
                <TextBlock x:Name="HostKeyStatus" Text="Primera conexión: AntiCLI detecta la clave antes de enviar credenciales. Vos decidís si confiar."
                           FontSize="12" TextWrapping="Wrap"/>
                <TextBlock Text="Compará la huella con la consola del proveedor. Si cambia luego, AntiCLI bloquea la conexión."
                           FontSize="11" TextWrapping="Wrap" Opacity="0.7"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="7">
                <TextBlock Text="Usuario SSH"/>
                <TextBox x:Name="UserInput" Watermark="developer"/>
                <CheckBox x:Name="RememberUser" Content="Recordar usuario mediante DPAPI"/>
                <TextBlock Text="Autenticación principal"/>
                <ComboBox x:Name="AuthModeSelector" Width="260" HorizontalAlignment="Left"/>
                <TextBlock Text="Archivo de clave privada SSH"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <TextBox x:Name="KeyPathInput" Grid.Column="0" Watermark="Seleccionar archivo de clave SSH"/>
                  <Button Grid.Column="1" Content="Buscar..." Click="ChooseKeyClicked"/>
                </Grid>
                <CheckBox x:Name="RememberKey" Content="Recordar clave privada cifrada con DPAPI"/>
                <TextBlock Text="Contraseña de la cuenta SSH"/>
                <TextBox x:Name="PasswordInput" PasswordChar="●" Watermark="Contraseña SSH"/>
                <CheckBox x:Name="RememberPassword" Content="Recordar contraseña mediante DPAPI"/>
                <TextBlock Text="Passphrase de la clave SSH"/>
                <TextBox x:Name="PassphraseInput" PasswordChar="●" Watermark="Passphrase de la clave (si tiene)"/>
                <CheckBox x:Name="RememberPassphrase" Content="Recordar passphrase mediante DPAPI"/>
                <TextBlock Text="Cuando los datos no se recuerdan, hay que ingresarlos nuevamente al abrir el programa."
                           FontSize="11" TextWrapping="Wrap" Opacity="0.7"/>
              </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Content="Guardar perfil" Click="SaveProfileClicked"/>
              <Button Content="Autenticar por SSH" Click="ConnectClicked"/>
              <Button Content="Desconectar / bloquear" Click="DisconnectClicked"/>
            </StackPanel>
            <TextBlock x:Name="AuthStatus" Text="Elegí un sistema remoto y configurá SSH." TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="CommandsTab" Header="2 · Comandos y bloques" IsEnabled="False">
        <Grid x:Name="CommandsWorkspace" Margin="5" ColumnDefinitions="11*,9*" RowDefinitions="*,Auto"
              ColumnSpacing="8" RowSpacing="6" MinHeight="0" MinWidth="0">
          <local:CommandWorkspaceView x:Name="BrowsePane" Grid.Column="0" Grid.Row="0"
                                      MinHeight="0" MinWidth="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
          <local:SshTerminalPane x:Name="SideConsolePane" Grid.Column="1" Grid.Row="0"
                                 MinHeight="0" MinWidth="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
          <local:CommandEntryPane x:Name="CommandBar" Grid.Row="1" Grid.Column="0"
                                  Grid.ColumnSpan="2" MaxHeight="175" MinHeight="110" MinWidth="0"/>
        </Grid>
      </TabItem>
      <TabItem x:Name="ModulesTab" Header="3 · Crear módulos" IsEnabled="False">
        <ScrollViewer>
          <StackPanel Margin="15" Spacing="12">
            <TextBlock FontSize="19" FontWeight="SemiBold" Text="Creador de módulos de consola"/>
            <TextBlock Text="Explorá ayudas CLI en servidores de prueba autorizados. Los comandos descubiertos se incorporan como sugerencias; el administrador puede ejecutarlos."
                       TextWrapping="Wrap"/>
            <TextBlock Text="Nombre de ejecutable"/>
            <TextBox x:Name="ToolToDiscover" Watermark="salt, docker, git, bitbake..." Width="360" HorizontalAlignment="Left"/>
            <CheckBox x:Name="HelpConsent" Content="Autorizo explorar ayudas --help en este servidor de PRUEBAS"/>
            <Button Content="Analizar ayuda y crear borrador" Click="ScanHelpClicked" HorizontalAlignment="Left"/>
            <TextBlock x:Name="ScanStatus" Text="Sin escaneos en esta sesión." TextWrapping="Wrap"/>
            <TextBlock Text="Los comandos descubiertos quedan señalados por riesgo; podés ejecutarlos como cualquier comando escrito manualmente. La traducción avanzada con IA está pendiente." TextWrapping="Wrap"/>
            <TextBlock FontWeight="SemiBold" FontSize="18" Text="Editor de fichas JSON · sin programar nuevas pantallas"/>
            <TextBlock Text="Editá el nombre, ejecutable, plantilla, flags y parámetros. Generá JSON, validalo y guardalo en AppData. Si necesitás opciones avanzadas, corregí el JSON directamente antes de guardar." TextWrapping="Wrap"/>
            <ComboBox x:Name="ModuleEditorSource" Width="360" HorizontalAlignment="Left"
                      SelectionChanged="ModuleEditorSourceChanged" PlaceholderText="Plantilla para editar"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Nuevo módulo" Click="ModuleEditorNewClicked"/>
              <Button Content="Cargar plantilla" Click="ModuleEditorLoadClicked"/>
            </StackPanel>
            <TextBlock Text="ID único (prefijo local.), nombre y ejecutable"/>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="7">
              <TextBox x:Name="ModuleEditorId" Grid.Column="0" Watermark="local.mi-herramienta"/>
              <TextBox x:Name="ModuleEditorTitle" Grid.Column="1" Watermark="Nombre visible"/>
              <TextBox x:Name="ModuleEditorExecutable" Grid.Column="2" Watermark="ejecutable"/>
            </Grid>
            <TextBox x:Name="ModuleEditorDescription" Watermark="Explicación en español"/>
            <TextBox x:Name="ModuleEditorKeywords" Watermark="Términos de búsqueda separados por espacios"/>
            <TextBlock Text="Plantilla con {flags} y nombres de parámetros entre llaves"/>
            <TextBox x:Name="ModuleEditorTemplate" Watermark="ejecutable {flags} {argumento}"/>
            <TextBlock Text="Flags: una por línea · token | etiqueta | descripción | tipo | valor inicial | predeterminado (true/false)"/>
            <TextBox x:Name="ModuleEditorFlags" AcceptsReturn="True" MinHeight="80" MaxHeight="220"
                     FontFamily="Consolas,Monospace" TextWrapping="NoWrap"/>
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Button Content="+ Añadir flag" Click="ModuleEditorAddFlagClicked"/>
              <Button Content="Editar líneas como filas" Click="ModuleEditorRebuildRowsClicked"/>
            </StackPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Auto">
              <StackPanel x:Name="ModuleEditorFlagRows" Spacing="5"/>
            </ScrollViewer>
            <TextBlock Text="Parámetros: nombre | etiqueta | descripción | tipo | requerido (true/false) | valor inicial"/>
            <TextBox x:Name="ModuleEditorOperands" AcceptsReturn="True" MinHeight="80" MaxHeight="220"
                     FontFamily="Consolas,Monospace" TextWrapping="NoWrap"/>
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Button Content="+ Añadir parámetro" Click="ModuleEditorAddOperandClicked"/>
              <Button Content="Pasar filas al JSON" Click="ModuleEditorGenerateClicked"/>
            </StackPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Auto">
              <StackPanel x:Name="ModuleEditorOperandRows" Spacing="5"/>
            </ScrollViewer>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Generar JSON desde formulario" Click="ModuleEditorGenerateClicked"/>
              <Button Content="Validar JSON" Click="ModuleEditorValidateClicked"/>
              <Button Content="Guardar y activar módulo" Click="ModuleEditorSaveClicked"/>
            </StackPanel>
            <TextBlock x:Name="ModuleEditorStatus" Text="Sin modificaciones." TextWrapping="Wrap"/>
            <TextBox x:Name="ModuleEditorJson" AcceptsReturn="True" MinHeight="240"
                     FontFamily="Consolas,Monospace" TextWrapping="NoWrap"
                     Watermark="JSON editable. Revisá antes de guardar."/>
            <TextBox x:Name="ScanOutput" IsReadOnly="True" MinHeight="210" AcceptsReturn="True"
                     TextWrapping="Wrap" FontFamily="Consolas,Monospace"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="AutomationTab" Header="4 · Automatizaciones">
        <Grid Margin="8" ColumnDefinitions="*,*" ColumnSpacing="10" MinHeight="0">
          <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" MinHeight="0">
            <StackPanel Margin="5" Spacing="8">
              <TextBlock Text="Constructor universal de cadenas y lotes" FontWeight="SemiBold" FontSize="19"/>
              <TextBlock Text="Sumá pasos de cualquier módulo o escribí plantillas con variables {{nombre}}. Las filas comparten variables fijas o tienen valores distintos. Se exporta como script editable; no ejecuta ni instala nada automáticamente."
                         TextWrapping="Wrap"/>
              <TextBlock Text="Nombre del flujo"/>
              <TextBox x:Name="AutomationName" Text="Mi automatización" Watermark="Nombre del flujo"/>
              <TextBlock Text="Plantilla del siguiente paso" FontWeight="SemiBold"/>
              <TextBox x:Name="AutomationStepInput" Watermark="Ej.: mkdir -p -- {{carpeta}}"/>
              <WrapPanel ItemSpacing="6" LineSpacing="5">
                <Button Content="+ Agregar paso" Click="AutomationAddStepClicked"/>
                <Button Content="Editar paso" Click="AutomationEditStepClicked"/>
                <Button Content="Reemplazar paso" Click="AutomationReplaceStepClicked"/>
                <Button Content="+ Comando actual de AntiCLI" Click="AutomationAddCurrentClicked"/>
                <Button Content="↑ Subir" Click="AutomationMoveUpClicked"/>
                <Button Content="↓ Bajar" Click="AutomationMoveDownClicked"/>
                <Button Content="Quitar paso" Click="AutomationRemoveStepClicked"/>
              </WrapPanel>
              <ListBox x:Name="AutomationStepsList" MinHeight="80" MaxHeight="145"/>
              <TextBlock Text="Variables fijas (nombre=valor, una por línea)" FontWeight="SemiBold"/>
              <TextBox x:Name="AutomationConstants" AcceptsReturn="True" MinHeight="55" MaxHeight="110"
                       FontFamily="Consolas,Monospace" Watermark="grupo=estudiantes"/>
              <TextBlock Text="Tabla de variables por fila (separá columnas con ; o Tab)" FontWeight="SemiBold"/>
              <TextBox x:Name="AutomationRows" AcceptsReturn="True" MinHeight="115" MaxHeight="230"
                       FontFamily="Consolas,Monospace" TextWrapping="NoWrap"
                       Text="usuario;carpeta&#10;alumno01;/home/alumno01&#10;alumno02;/home/alumno02"/>
              <TextBlock Text="Para generar filas numeradas sin escribirlas una por una:"/>
              <TextBox x:Name="AutomationColumns" Text="usuario;carpeta" Watermark="Columnas separadas por ;"/>
              <TextBox x:Name="AutomationPrefixes" Text="alumno{n};/home/alumno{n}"
                       Watermark="Un prefijo por columna, usando {n} para el número"/>
              <WrapPanel ItemSpacing="7" LineSpacing="5">
                <TextBlock Text="Cantidad" VerticalAlignment="Center"/>
                <TextBox x:Name="AutomationCount" Width="55" Text="20"/>
                <TextBlock Text="Inicio" VerticalAlignment="Center"/>
                <TextBox x:Name="AutomationStart" Width="55" Text="1"/>
                <TextBlock Text="Dígitos" VerticalAlignment="Center"/>
                <TextBox x:Name="AutomationDigits" Width="55" Text="2"/>
                <Button Content="Generar filas" Click="AutomationNumberedRowsClicked"/>
              </WrapPanel>
              <CheckBox x:Name="AutomationStepMajor" Content="Ejecutar primero un paso para todas las filas (si no, todos los pasos de cada fila)"/>
              <CheckBox x:Name="AutomationContinueOnError" Content="Continuar con el siguiente paso si falla uno (por defecto se detiene)"/>
              <TextBlock Text="Variables de plantilla: {{usuario}}, {{carpeta}}, {{grupo}}. Los valores se entrecomillan al generar el script. Revisá especialmente pasos destructivos y secretos." TextWrapping="Wrap" FontSize="12"/>
            </StackPanel>
          </ScrollViewer>
          <TabControl x:Name="AutomationRightTabs" Grid.Column="1" MinHeight="0" SelectedIndex="1">
            <TabItem x:Name="FlowDesignerTab" Header="Diagrama visual" IsVisible="False">
              <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="7" Margin="6" MinHeight="0">
                <TextBlock Text="Bloques y flechas · arrastrá los nodos con el mouse" FontWeight="SemiBold"
                           FontSize="16" TextWrapping="Wrap"/>
                <WrapPanel Grid.Row="1" ItemSpacing="5" LineSpacing="5">
                  <Button Content="+ Comando" Click="FlowAddCommandClicked"/>
                  <Button Content="+ Bucle ↺" Click="FlowAddLoopClicked" ToolTip.Tip="FOR (veces), WHILE (mientras), UNTIL (hasta), todos con límite de iteraciones"/>
                  <Button Content="+ IF" Click="FlowAddIfClicked"/>
                  <Button Content="+ AND" Click="FlowAddAndClicked"/>
                  <Button Content="+ OR" Click="FlowAddOrClicked"/>
                  <Button Content="+ XOR" Click="FlowAddXorClicked"/>
                  <Button Content="+ Paralelo" Click="FlowAddParallelClicked"/>
                  <Button Content="+ Unión" Click="FlowAddJoinClicked"/>
                </WrapPanel>
                <StackPanel Grid.Row="2" Spacing="5">
                  <WrapPanel ItemSpacing="6" LineSpacing="5">
                    <Button Content="Conectar →" Click="FlowConnectNextClicked"/>
                    <Button Content="▶ Marcar inicio" Click="FlowSetStartClicked"/>
                    <Button Content="Cuerpo del bucle" Click="FlowConnectBodyClicked"/>
                    <Button Content="Retorno ↺" Click="FlowConnectBackClicked"/>
                    <Button Content="Verdadero" Click="FlowConnectTrueClicked"/>
                    <Button Content="Falso" Click="FlowConnectFalseClicked"/>
                    <Button Content="Paralelo" Click="FlowConnectParallelClicked"/>
                    <Button Content="Quitar bloque" Click="FlowRemoveClicked"/>
                    <Button Content="Guardar JSON" Click="FlowSaveClicked"/>
                    <Button Content="Abrir JSON" Click="FlowLoadClicked"/>
                  </WrapPanel>
                  <TextBox x:Name="FlowNodeTitle" Watermark="Nombre del nodo seleccionado"/>
                  <TextBox x:Name="FlowNodeCommand" Watermark="Comando del nodo o condición WHILE/UNTIL, ej.: test -f /tmp/seguir"/>
                  <WrapPanel x:Name="FlowLoopSettings" IsVisible="False" ItemSpacing="9" LineSpacing="5" Orientation="Horizontal">
                    <TextBlock Text="Modo de bucle" VerticalAlignment="Center"/>
                    <ComboBox x:Name="FlowLoopModeSelector" Width="115" SelectedIndex="0">
                      <ComboBoxItem Content="FOR"/>
                      <ComboBoxItem Content="WHILE"/>
                      <ComboBoxItem Content="UNTIL"/>
                    </ComboBox>
                    <TextBlock Text="Límite (0 = sin límite en WHILE/UNTIL)" VerticalAlignment="Center"/>
                    <TextBox x:Name="FlowLoopMaxCount" Width="75" Text="20"/>
                  </WrapPanel>
                  <Button Content="Aplicar título/comando al nodo" Click="FlowUpdateNodeClicked"
                          HorizontalAlignment="Left"/>
                  <TextBlock x:Name="FlowStatus" Text="Podés conectar Retorno ↺ a cualquier comando anterior. IF ejecuta el test: 0 = Verdadero, otro código = Falso. Cualquier salida sin conexión termina; conectá Falso → reintento para esperar hasta OK. Marcá ▶ Inicio donde deba comenzar, incluso en un ciclo. Sin límite obligatorio; detené manualmente los flujos indefinidos."
                             TextWrapping="Wrap" FontSize="12"/>
                </StackPanel>
                <ScrollViewer Grid.Row="3" MinHeight="0"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                  <Canvas x:Name="FlowCanvas" Width="1200" Height="900" Background="#1E2631"/>
                </ScrollViewer>
              </Grid>
            </TabItem>
            <TabItem Header="Script / proyecto">
              <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="7" Margin="6" MinHeight="0">
                <TextBlock Text="Script y automatización. El diagrama visual se abre con el botón ↗." FontWeight="SemiBold" FontSize="17" TextWrapping="Wrap"/>
                <WrapPanel Grid.Row="1" ItemSpacing="6" LineSpacing="5">
                  <Button Content="Abrir diagrama ↗" Click="OpenFlowWindowClicked" Background="#285E75" Foreground="White" ToolTip.Tip="Abre el diagrama en una ventana independiente, apta para un segundo monitor"/>
                  <Button Content="Generar vista previa" Click="AutomationPreviewClicked"/>
                  <Button Content="Guardar .sh" Click="AutomationSaveScriptClicked"/>
                  <Button Content="Guardar proyecto JSON" Click="AutomationSaveProjectClicked"/>
                  <Button Content="Abrir proyecto JSON" Click="AutomationLoadProjectClicked"/>
                </WrapPanel>
                <TextBlock Grid.Row="2" x:Name="AutomationStatus" Text="Prepará los pasos; se podrá exportar sin conexión SSH." TextWrapping="Wrap"/>
                <TextBox Grid.Row="3" x:Name="AutomationScriptPreview" AcceptsReturn="True" IsReadOnly="True"
                         FontFamily="Consolas,Monospace" TextWrapping="NoWrap"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
              </Grid>
            </TabItem>
          </TabControl>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
