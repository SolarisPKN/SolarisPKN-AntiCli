<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SolarisPKN.AntiCli.DetachedConsoleWindow"
        Title="AntiCLI · Registro SSH"
        Width="1100" Height="730" MinWidth="500" MinHeight="350"
        WindowStartupLocation="Manual">
  <Grid Margin="9" RowDefinitions="Auto,*" RowSpacing="7">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <StackPanel Spacing="3">
        <TextBlock Text="Registro SSH · ventana independiente" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock x:Name="SessionLabel" Text="Sin sesión" TextWrapping="Wrap"/>
        <TextBlock x:Name="StatusLabel" Text="Sin comandos ejecutados" Opacity="0.8" TextWrapping="Wrap"/>
      </StackPanel>
      <WrapPanel Grid.Column="1" ItemSpacing="7" LineSpacing="5" VerticalAlignment="Top">
        <Button x:Name="MaximizeButton" Content="Maximizar" Click="ToggleMaximizeClicked"/>
        <Button Content="Copiar registro" Click="CopyLogClicked"/>
        <Button Content="Acoplar ↙" Click="DockConsoleClicked"/>
      </WrapPanel>
    </Grid>
    <TextBox x:Name="ConsoleHistory" Grid.Row="1" IsReadOnly="True"
             AcceptsReturn="True" TextWrapping="NoWrap"
             FontFamily="Consolas,Monospace"
             ScrollViewer.HorizontalScrollBarVisibility="Auto"
             ScrollViewer.VerticalScrollBarVisibility="Visible"
             Watermark="El historial compartido de esta sesión aparecerá aquí."/>
  </Grid>
</Window>
