<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SolarisPKN.AntiCli.DetachedConsoleWindow"
        Title="Solaris AntiCLI · Consola SSH desacoplada"
        Width="1080" Height="720" MinWidth="540" MinHeight="400"
        WindowStartupLocation="Manual">
  <Grid Margin="12" RowDefinitions="Auto,*,Auto" RowSpacing="10">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <StackPanel Spacing="4">
        <TextBlock Text="Consola SSH · ventana independiente" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock x:Name="SessionLabel" Text="Sin sesión" TextWrapping="Wrap"/>
        <TextBlock x:Name="StatusLabel" Text="Sin comandos ejecutados" TextWrapping="Wrap" Opacity="0.8"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
        <Button x:Name="MaximizeButton" Content="Maximizar" Click="ToggleMaximizeClicked"/>
        <Button Content="Acoplar al sistema ↙" Click="DockConsoleClicked"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" RowDefinitions="2*,*" RowSpacing="9">
      <Grid Grid.Row="0" RowDefinitions="Auto,*" RowSpacing="5">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Salida del último comando SSH" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button Content="Copiar salida" Click="CopyOutputClicked"/>
        </StackPanel>
        <TextBox x:Name="ConsoleOutput" Grid.Row="1" IsReadOnly="True"
                 AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="Consolas,Monospace" HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto"/>
      </Grid>
      <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="5">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Historial completo de esta sesión" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button Content="Copiar historial" Click="CopyLogClicked"/>
        </StackPanel>
        <TextBox x:Name="ConsoleHistory" Grid.Row="1" IsReadOnly="True"
                 AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="Consolas,Monospace" HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto"/>
      </Grid>
    </Grid>
    <Border Grid.Row="2" BorderBrush="#777777" BorderThickness="1" Padding="9" CornerRadius="7">
      <StackPanel Spacing="6">
        <TextBlock Text="Comando manual para esta misma sesión SSH" FontWeight="SemiBold"/>
        <TextBox x:Name="ConsoleCommand" Watermark="Comando SSH..." TextChanged="CommandTextChanged"/>
        <StackPanel Orientation="Horizontal" Spacing="9">
          <CheckBox x:Name="ConsoleSudo" Content="sudo -n (Linux)" Checked="SudoChanged"
                    Unchecked="SudoChanged" VerticalAlignment="Center"/>
          <Button x:Name="ConsoleExecute" Content="🔴 Ejecutar comando" Click="ExecuteClicked"
                  Background="#B33131" Foreground="White"/>
          <TextBlock x:Name="RiskLabel" Text="🔴 Comando no catalogado" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="Una sola ejecución SSH compartida con AntiCLI. La salida se actualiza al iniciar y al finalizar el comando; todavía no es streaming continuo."
                   FontSize="11" TextWrapping="Wrap" Opacity="0.7"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>