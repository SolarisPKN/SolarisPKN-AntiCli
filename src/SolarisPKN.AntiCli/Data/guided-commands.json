    {
      "Id": "apt-repository",
      "Executable": "apt",
      "TitleEs": "Agregar repositorio externo con clave verificada",
      "ExplanationEs": "Configurá un origen APT tipo deb822. Verifica la huella de la clave GPG antes de instalarla y limita esa clave al repositorio mediante Signed-By. No usa apt-key.",
      "SearchTerms": "agregar repositorio instalar origen apt fuente externa url llave clave gpg signed-by deb822",
      "Risk": "Red",
      "Template": "set -eu\nrepo_id={repo_id}\nrepo_uri={repo_uri}\nsuite={suite}\ncomponents={components}\nkey_uri={key_uri}\nfingerprint={fingerprint}\ntmp=\"$(mktemp -d)\"\ntrap 'rm -rf \"$tmp\"' EXIT\nmkdir -p /etc/apt/keyrings\ncurl -fsSL --max-time 30 \"$key_uri\" -o \"$tmp/vendor.asc\"\ngot=\"$(gpg --batch --show-keys --with-colons \"$tmp/vendor.asc\" 2>/dev/null | awk -F: '$1==\"fpr\" { print $10; exit }')\"\ntest \"$got\" = \"$fingerprint\" || { echo 'ERROR: huella GPG no coincide'; exit 4; }\ngpg --batch --yes --dearmor -o \"$tmp/vendor.gpg\" \"$tmp/vendor.asc\"\ninstall -m 0644 \"$tmp/vendor.gpg\" \"/etc/apt/keyrings/${repo_id}.gpg\"\nprintf 'Types: deb\\nURIs: %s\\nSuites: %s\\nComponents: %s\\nSigned-By: /etc/apt/keyrings/%s.gpg\\n' \"$repo_uri\" \"$suite\" \"$components\" \"$repo_id\" > \"/etc/apt/sources.list.d/${repo_id}.sources\"\napt-get update",
      "Flags": [],
      "Operands": [
        {
          "Name": "repo_id",
          "LabelEs": "Identificador del repositorio",
          "DescriptionEs": "Solo letras minúsculas, números y guiones; define nombres de archivos.",
          "ValueKind": "Identifier",
          "Placeholder": "ejemplo-repo",
          "Required": true,
          "InitialValue": ""
        },
        {
          "Name": "repo_uri",
          "LabelEs": "URL del repositorio",
          "DescriptionEs": "Dirección HTTPS de la raíz APT del proveedor.",
          "ValueKind": "UrlHttps",
          "Placeholder": "https://packages.example.org/debian",
          "Required": true,
          "InitialValue": ""
        },
        {
          "Name": "suite",
          "LabelEs": "Versión / suite",
          "DescriptionEs": "Distribución o suite del proveedor: noble, stable, bookworm...",
          "ValueKind": "Suite",
          "Placeholder": "noble",
          "Required": true,
          "InitialValue": ""
        },
        {
          "Name": "components",
          "LabelEs": "Componentes",
          "DescriptionEs": "Uno o varios componentes separados por espacios, ej. main contrib.",
          "ValueKind": "Components",
          "Placeholder": "main",
          "Required": true,
          "InitialValue": ""
        },
        {
          "Name": "key_uri",
          "LabelEs": "URL de la clave GPG",
          "DescriptionEs": "URL HTTPS de la clave ASCII pública proporcionada por el editor.",
          "ValueKind": "UrlHttps",
          "Placeholder": "https://packages.example.org/key.asc",
          "Required": true,
          "InitialValue": ""
        },
        {
          "Name": "fingerprint",
          "LabelEs": "Huella GPG esperada",
          "DescriptionEs": "Fingerprint completo de la clave según el editor; requisito de seguridad.",
          "ValueKind": "Fingerprint",
          "Placeholder": "0123456789ABCDEF0123456789ABCDEF01234567",
          "Required": true,
          "InitialValue": ""
        }
      ],
      "SupportsBatch": false,
      "TimeoutSeconds": 420,
      "DocumentationUrl": "https://manpages.ubuntu.com/manpages/noble/en/man5/sources.list.5.html"
    },
