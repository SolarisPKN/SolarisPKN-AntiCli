    {
      "Id": "apt-sources",
      "Family": "apt",
      "Executable": "",
      "TitleEs": "Agregar repositorio externo seguro (deb822)",
      "SearchTerms": [
        "agregar repositorio",
        "url apt",
        "clave gpg",
        "firma",
        "signed-by"
      ],
      "Risk": "Red",
      "Source": "https://manpages.ubuntu.com/manpages/noble/man5/sources.list.5.html",
      "Workflow": "deb822-signed-by",
      "Fields": [
        {
          "Name": "name",
          "LabelEs": "Nombre corto del repositorio",
          "Type": "text",
          "Required": true,
          "Validation": "safe-filename"
        },
        {
          "Name": "uri",
          "LabelEs": "URL del repositorio HTTPS",
          "Type": "url",
          "Required": true,
          "Validation": "https-only"
        },
        {
          "Name": "suite",
          "LabelEs": "Suite / codename (ej.: noble)",
          "Type": "text",
          "Required": true
        },
        {
          "Name": "components",
          "LabelEs": "Componentes (ej.: main)",
          "Type": "text",
          "Required": true
        },
        {
          "Name": "architectures",
          "LabelEs": "Arquitecturas (ej.: amd64)",
          "Type": "text",
          "Required": false
        },
        {
          "Name": "keyUrl",
          "LabelEs": "URL HTTPS de la clave pública publicada por el proveedor",
          "Type": "url",
          "Required": true,
          "Validation": "https-only"
        },
        {
          "Name": "keyFingerprint",
          "LabelEs": "Huella completa esperada de la clave OpenPGP",
          "Type": "text",
          "Required": true,
          "Validation": "gpg-fingerprint"
        }
      ],
      "Steps": [
        "Descargar clave por HTTPS con límite de tamaño",
        "Comprobar huella OpenPGP contra documentación oficial por canal independiente",
        "Guardar clave en /etc/apt/keyrings/NOMBRE.gpg o .asc",
        "Crear /etc/apt/sources.list.d/NOMBRE.sources con Signed-By",
        "Validar fuente y ejecutar apt-get update"
      ],
      "Rules": [
        "Prohibido usar apt-key y trusted=yes",
        "No suprimir errores TLS o firmas",
        "La huella debe estar suministrada y contrastada, nunca inventada",
        "Si se interrumpe el proceso, no dejar fuentes parcialmente activas"
      ]
    },
